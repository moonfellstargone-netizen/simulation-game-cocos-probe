{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "time_state.schema.json",
  "type": "object",
  "required": [
    "world_day",
    "world_minute",
    "absolute_minute",
    "season",
    "weather"
  ],
  "additionalProperties": false,
  "properties": {
    "world_day": {
      "type": "integer",
      "minimum": 1
    },
    "world_minute": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1439,
      "description": "日内分钟。清晨 06:00 记为 360。"
    },
    "absolute_minute": {
      "type": "integer",
      "minimum": 0,
      "description": "从当前存档世界起点累计的绝对分钟，用于跨日结算与日志排序。"
    },
    "season": {
      "type": "string"
    },
    "weather": {
      "type": "string"
    },
    "time_segment": {
      "type": "string"
    }
  }
}
