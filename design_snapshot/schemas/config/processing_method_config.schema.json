{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "processing_method_config.schema.json",
  "type": "object",
  "required": [
    "id",
    "display_name_key",
    "input_view_requirements",
    "time_cost_minutes",
    "process_duration_minutes",
    "property_transform_rules",
    "output_form_rules"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "display_name_key": {
      "type": "string"
    },
    "input_view_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "category": {
            "type": "string"
          },
          "base_id": {
            "type": "string"
          },
          "allowed_base_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allowed_forms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "min_freshness": {
            "type": "number"
          },
          "min_quantity_g": {
            "type": "number"
          }
        }
      }
    },
    "tool_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "facility_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "time_cost_minutes": {
      "type": "integer"
    },
    "process_duration_minutes": {
      "type": "integer"
    },
    "environment_effects": {
      "type": "object",
      "required": [],
      "additionalProperties": false,
      "properties": {
        "temperature_sensitive": {
          "type": "boolean"
        },
        "cleanliness_sensitive": {
          "type": "boolean"
        }
      }
    },
    "property_transform_rules": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "number",
          "string",
          "boolean",
          "object"
        ]
      }
    },
    "defect_rules": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "condition"
        ],
        "additionalProperties": false,
        "properties": {
          "condition": {
            "type": "string"
          }
        }
      }
    },
    "recovery_options": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "output_form_rules": {
      "type": "object",
      "required": [],
      "additionalProperties": false,
      "properties": {
        "success_form": {
          "type": "string"
        },
        "risky_form": {
          "type": "string"
        }
      }
    },
    "event_log_rules": {
      "type": "object",
      "required": [],
      "additionalProperties": false,
      "properties": {
        "started_key": {
          "type": "string"
        },
        "completed_key": {
          "type": "string"
        }
      }
    }
  }
}
