{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "domain_event.schema.json",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "world_time",
    "source_action_id",
    "actor_id",
    "payload",
    "visibility"
  ],
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "world_time": {
      "type": "integer",
      "minimum": 0
    },
    "source_action_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "actor_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "debug_only": {
      "type": "boolean",
      "default": false
    },
    "visibility": {
      "enum": [
        "internal",
        "debug",
        "player_visible"
      ]
    },
    "event_type": {
      "type": "string"
    },
    "payload": {
      "not": {
        "type": "null"
      },
      "description": "Payload is validated by event_type-specific oneOf branches."
    }
  },
  "$defs": {
    "LotPayload": {
      "type": "object",
      "required": [
        "lot_id",
        "base_id",
        "quantity"
      ],
      "additionalProperties": false,
      "properties": {
        "lot_id": {
          "type": "string"
        },
        "base_id": {
          "type": "string"
        },
        "quantity": {
          "$ref": "common_defs.schema.json#/$defs/Quantity"
        }
      }
    },
    "ObjectPayload": {
      "type": "object",
      "required": [
        "object_ref"
      ],
      "additionalProperties": false,
      "properties": {
        "object_ref": {
          "$ref": "common_defs.schema.json#/$defs/ObjectRef"
        }
      }
    },
    "ReservationPayload": {
      "type": "object",
      "required": [
        "reservation_id"
      ],
      "additionalProperties": false,
      "properties": {
        "reservation_id": {
          "type": "string"
        },
        "lot_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "quantity": {
          "$ref": "common_defs.schema.json#/$defs/Quantity"
        }
      }
    },
    "OrderPayload": {
      "type": "object",
      "required": [
        "order_id"
      ],
      "additionalProperties": false,
      "properties": {
        "order_id": {
          "type": "string"
        },
        "submitted_object_refs": {
          "type": "array",
          "items": {
            "$ref": "common_defs.schema.json#/$defs/SubmittedObjectRef"
          }
        }
      }
    },
    "DebugPayload": {
      "type": "object",
      "required": [
        "note_key"
      ],
      "additionalProperties": false,
      "properties": {
        "note_key": {
          "type": "string"
        },
        "debug_code": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ProcessingTaskPayload": {
      "type": "object",
      "required": [
        "task_id"
      ],
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "type": "string"
        },
        "method_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "input_lot_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "lot_id",
              "quantity"
            ],
            "additionalProperties": false,
            "properties": {
              "lot_id": {
                "type": "string"
              },
              "quantity": {
                "$ref": "common_defs.schema.json#/$defs/Quantity"
