      "properties": {
        "crop_id": {
          "type": "string"
        },
        "field_plot_id": {
          "type": "string"
        },
        "crop_base_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_lot_refs": {
          "type": "array",
          "items": {
            "$ref": "common_defs.schema.json#/$defs/ObjectRef"
          }
        }
      }
    },
