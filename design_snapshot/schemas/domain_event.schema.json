        "from_absolute_minute",
        "to_absolute_minute"
      ],
      "additionalProperties": false,
      "properties": {
        "minutes": {
          "type": "integer",
          "minimum": 0
        },
        "from_absolute_minute": {
          "type": "integer",
          "minimum": 0
        },
        "to_absolute_minute": {
          "type": "integer",
          "minimum": 0
        },
        "triggered_summary": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
