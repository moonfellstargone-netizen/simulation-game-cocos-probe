{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crop_instance.schema.json",
  "type": "object",
  "required": [
    "crop_id",
    "crop_base_id",
    "seed_lot_id",
    "field_plot_id",
    "planted_time",
    "growth_stage",
    "lifecycle_status",
    "growth_progress",
    "expected_harvest_minute",
    "health",
    "flags"
  ],
  "additionalProperties": false,
  "properties": {
    "seed_lot_snapshot": { "$ref": "common_defs.schema.json#/$defs/SeedLotSnapshot" },
    "crop_id": {
      "type": "string",
      "minLength": 1
    },
    "crop_base_id": {
      "type": "string",
      "minLength": 1
    },
    "seed_lot_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "field_plot_id": {
      "type": "string",
      "minLength": 1
    },
    "planted_time": {
      "type": "integer",
      "minimum": 0
    },
    "growth_stage": {
      "enum": [
        "seed",
        "sprout",
        "growing",
        "mature",
        "withered"
      ]
    },
    "lifecycle_status": {
      "enum": [
        "active",
        "ready_to_harvest",
        "harvested",
        "removed",
        "failed"
      ]
    },
    "growth_progress": {
      "type": "number",
      "minimum": 0
    },
    "expected_harvest_minute": {
      "type": "integer",
      "minimum": 0
    },
    "health": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "season_context": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_ref": {
      "$ref": "common_defs.schema.json#/$defs/SourceRef"
    },
    "created_time": {
      "type": "integer",
      "minimum": 0
    },
    "last_update_time": {
      "type": "integer",
      "minimum": 0
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "germination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_version",
        "seeds_per_tile",
        "per_seed_success_rate",
        "reveal_growth_progress",
        "outcome",
        "revealed"
      ],
      "properties": {
        "policy_version": {
          "const": "independent-seeds-v1"
        },
        "seeds_per_tile": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "per_seed_success_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reveal_growth_progress": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 100
        },
        "outcome": {
          "enum": [
            "succeeded",
            "failed"
          ]
        },
        "revealed": {
          "type": "boolean"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "germination"
        ],
        "properties": {
          "germination": {
            "properties": {
              "revealed": {
                "const": false
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "lifecycle_status": {
            "const": "active"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "germination"
        ],
        "properties": {
          "germination": {
            "properties": {
              "revealed": {
                "const": true
              },
              "outcome": {
                "const": "failed"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "lifecycle_status": {
            "const": "failed"
          },
          "growth_stage": {
            "const": "withered"
          },
          "health": {
            "const": 0
          }
        }
      }
    }
  ]
}
